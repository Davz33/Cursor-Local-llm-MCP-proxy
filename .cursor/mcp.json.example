{
  "mcpServers": {
    "local-llm-proxy": {
      "command": "node",
      "args": [
        "/path/to/local-llm-proxy/dist/index.js"
      ],
      "autoApprove": [
        "generate_commit_message"
      ],
      "env": {
        "LOCAL_LLM_URL": "http://127.0.0.1:1234/v1",
        "LM_STUDIO_MODEL": "meta-llama-3.1-8b-instruct",
        "ENABLE_MCP_ORCHESTRATOR": "true"
      }
    }
  }
}
